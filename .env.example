# ============================================================================
# AMBATRAIN ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Salin berkas ini menjadi '.env' dan sesuaikan nilainya.
# JANGAN PERNAH MENYIMPAN FILE '.env' ASLI KE DALAM REPOSITORI PUBLIK!
# ============================================================================

# Database Supabase (Rekomendasi: Session Pooler Port 5432)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-strong-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Server C++ (Crow)
SERVER_HOST=0.0.0.0
PORT=8080
CORS_ORIGIN=http://localhost:5500

# Keamanan JWT
JWT_SECRET=ambatrain-dark-gothic-super-secret-jwt-key-2026-change-me
JWT_EXPIRES_IN=86400

# Konfigurasi Bisnis
HOLD_MINUTES=15

